# Copy this file to .env.local for a local preview, or set the same names in your
# hosting provider's environment variable settings. These are public links, not secrets.
# See docs/TIMETABLE.md.

# Google Sheets "Publish to web" CSV link for the timetable tab.
VITE_TIMETABLE_CSV_URL=

# Optional: the normal Google Sheets link the owner opens to edit the timetable.
VITE_TIMETABLE_SHEET_EDIT_URL=

# Optional override. The default Cal.com profile (bethnalgreenbc) is set in src/components/Classes.jsx.
VITE_CAL_LINK=

# Confirmed public direct WhatsApp is maintained in src/content.js.

# Public URL of an authorised Instagram feed cache. Never put account access tokens here.
VITE_INSTAGRAM_FEED_URL=
